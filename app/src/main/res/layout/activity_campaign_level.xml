<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Game View -->
    <com.spiritwisestudios.inkrollers.GameView
        android:id="@+id/game_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Campaign HUD Elements -->
    
    <!-- Mission Objectives Panel -->
    <LinearLayout
        android:id="@+id/objectives_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:background="@android:color/black"
        android:alpha="0.8"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        
        <TextView
            android:id="@+id/text_level_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mission: The Awakening"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/text_objectives_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Objectives:"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/text_coverage_objective"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Paint 70% of the area"
            android:textColor="@android:color/white"
            android:textSize="10sp" />
            
        <TextView
            android:id="@+id/text_robots_objective"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Convert 1 robot"
            android:textColor="@android:color/white"
            android:textSize="10sp" />
            
        <TextView
            android:id="@+id/text_secrets_objective"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Find 1 secret area"
            android:textColor="@android:color/white"
            android:textSize="10sp" />
    </LinearLayout>
    
    <!-- Coverage HUD -->
    <com.spiritwisestudios.inkrollers.CoverageHudView
        android:id="@+id/coverage_hud_view"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/objectives_panel" />

    <!-- Timer HUD -->
    <com.spiritwisestudios.inkrollers.TimerHudView
        android:id="@+id/timer_hud_view"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ink HUD -->
    <com.spiritwisestudios.inkrollers.InkHudView
        android:id="@+id/ink_hud_view"
        android:layout_width="150dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Campaign Controls -->
    
    <!-- Frequency Display -->
    <TextView
        android:id="@+id/text_frequency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="Frequency: RED"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/frequency_display_background"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Color Shift Button -->
    <Button
        android:id="@+id/button_color_shift"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="140dp"
        android:text="Color Shift"
        android:textSize="14sp"
        android:background="@drawable/color_shift_button_background"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
        
    <!-- Mode Toggle Button -->
    <Button
        android:id="@+id/button_mode_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:text="PAINT"
        android:textSize="14sp"
        android:background="@drawable/color_shift_button_background"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
        
    <!-- Level Progress Indicator -->
    <TextView
        android:id="@+id/text_level_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:text="Progress: 0%"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:background="@drawable/progress_display_background"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Back Button -->
    <Button
        android:id="@+id/button_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:text="Back"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout> 