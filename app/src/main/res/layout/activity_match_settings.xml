<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/title_bg"
    android:fillViewport="true"
    tools:context=".MatchSettingsActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Information/Tips Card on the Left -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/match_settings_card_margin"
            android:layout_marginEnd="@dimen/match_settings_item_margin"
            android:layout_marginTop="@dimen/match_settings_card_margin"
            android:layout_marginBottom="@dimen/match_settings_card_margin"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFC0C0C0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/card_settings"
            app:layout_constraintWidth_percent="0.28">

            <!-- Dark gray border/stroke -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_card_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/match_settings_card_padding"
                android:layout_margin="2dp">

                <!-- Info Title -->
                <TextView
                    android:id="@+id/info_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Game Info"
                    android:textSize="@dimen/match_settings_info_title_text_size"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/match_settings_card_margin" />

                <!-- Info Content -->
                <TextView
                    android:id="@+id/info_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configure your match settings:\n\n• Time Limit: How long the match will last\n\n• Maze Complexity: Affects maze generation difficulty\n\n• Game Mode: Coverage (paint territory) or Zones (control areas)\n\n• Robot Spawners: Add AI opponents to the match\n\n• Private: Requires Game ID to join"
                    android:textSize="@dimen/match_settings_info_content_text_size"
                    android:textColor="@android:color/black"
                    android:lineSpacingMultiplier="1.2" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Main Settings Card on the Right -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/match_settings_item_margin"
            android:layout_marginEnd="@dimen/match_settings_card_margin"
            android:layout_marginTop="@dimen/match_settings_card_margin"
            android:layout_marginBottom="@dimen/match_settings_card_margin"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFC0C0C0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/card_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.68">

            <!-- Dark gray border/stroke -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_card_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/match_settings_card_padding"
                android:layout_margin="2dp">

                <!-- Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Match Settings"
                    android:textSize="@dimen/match_settings_title_text_size"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/match_settings_card_margin" />

                <!-- Time Limit Setting -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/match_settings_item_margin">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="@dimen/match_settings_item_margin">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Time Limit:"
                            android:textSize="@dimen/match_settings_label_text_size"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:id="@+id/help_time_limit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="?"
                            android:textSize="@dimen/match_settings_help_button_text_size"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:background="@drawable/help_button_background"
                            android:layout_marginStart="@dimen/match_settings_item_margin"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:minWidth="@dimen/match_settings_help_button_size"
                            android:minHeight="@dimen/match_settings_help_button_size"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinner_time_limit"
                        android:layout_width="0dp"
                        android:layout_weight="1.5"
                        android:layout_height="@dimen/match_settings_spinner_height"
                        android:background="@drawable/spinner_background"
                        android:padding="8dp" />

                </LinearLayout>

                <!-- Maze Complexity Setting -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/match_settings_item_margin">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="@dimen/match_settings_item_margin">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Complexity:"
                            android:textSize="@dimen/match_settings_label_text_size"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:id="@+id/help_complexity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="?"
                            android:textSize="@dimen/match_settings_help_button_text_size"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:background="@drawable/help_button_background"
                            android:layout_marginStart="@dimen/match_settings_item_margin"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:minWidth="@dimen/match_settings_help_button_size"
                            android:minHeight="@dimen/match_settings_help_button_size"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinner_complexity"
                        android:layout_width="0dp"
                        android:layout_weight="1.5"
                        android:layout_height="@dimen/match_settings_spinner_height"
                        android:background="@drawable/spinner_background"
                        android:padding="8dp" />

                </LinearLayout>

                <!-- Game Mode Setting -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/match_settings_item_margin">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="@dimen/match_settings_item_margin">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Game Mode:"
                            android:textSize="@dimen/match_settings_label_text_size"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:id="@+id/help_game_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="?"
                            android:textSize="@dimen/match_settings_help_button_text_size"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:background="@drawable/help_button_background"
                            android:layout_marginStart="@dimen/match_settings_item_margin"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:minWidth="@dimen/match_settings_help_button_size"
                            android:minHeight="@dimen/match_settings_help_button_size"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinner_game_mode"
                        android:layout_width="0dp"
                        android:layout_weight="1.5"
                        android:layout_height="@dimen/match_settings_spinner_height"
                        android:background="@drawable/spinner_background"
                        android:padding="8dp" />

                </LinearLayout>

                <!-- Robot Spawners Setting -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/match_settings_item_margin">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="@dimen/match_settings_item_margin">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Spawners:"
                            android:textSize="@dimen/match_settings_label_text_size"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:id="@+id/help_spawners"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="?"
                            android:textSize="@dimen/match_settings_help_button_text_size"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:background="@drawable/help_button_background"
                            android:layout_marginStart="@dimen/match_settings_item_margin"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:minWidth="@dimen/match_settings_help_button_size"
                            android:minHeight="@dimen/match_settings_help_button_size"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinner_robot_spawners"
                        android:layout_width="0dp"
                        android:layout_weight="1.5"
                        android:layout_height="@dimen/match_settings_spinner_height"
                        android:background="@drawable/spinner_background"
                        android:padding="8dp" />

                </LinearLayout>

                <!-- Private Match Setting -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/match_settings_card_margin">

                    <CheckBox
                        android:id="@+id/checkbox_private"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Private"
                            android:textSize="@dimen/match_settings_label_text_size"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:id="@+id/help_private"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="?"
                            android:textSize="@dimen/match_settings_help_button_text_size"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:background="@drawable/help_button_background"
                            android:layout_marginStart="@dimen/match_settings_item_margin"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:minWidth="@dimen/match_settings_help_button_size"
                            android:minHeight="@dimen/match_settings_help_button_size"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/button_cancel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cancel"
                        android:textSize="@dimen/match_settings_button_text_size"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/cancel_button_background"
                        android:textColor="@android:color/white"
                        android:minHeight="@dimen/match_settings_button_height" />

                    <Button
                        android:id="@+id/button_host_game"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Host Game"
                        android:textSize="@dimen/match_settings_button_text_size"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/play_button_background"
                        android:textColor="@android:color/white"
                        android:minHeight="@dimen/match_settings_button_height" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>