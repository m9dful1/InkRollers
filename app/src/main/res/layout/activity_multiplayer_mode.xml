<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/title_bg"
    android:fillViewport="true"
    tools:context=".MultiplayerModeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Information/Tips Card on the Left -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/match_settings_card_margin"
            android:layout_marginEnd="@dimen/match_settings_item_margin"
            android:layout_marginTop="@dimen/match_settings_card_margin"
            android:layout_marginBottom="@dimen/match_settings_card_margin"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFC0C0C0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/card_options"
            app:layout_constraintWidth_percent="0.28">

            <!-- Dark gray border/stroke -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_card_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/match_settings_card_padding"
                android:layout_margin="2dp">

                <!-- Info Title -->
                <TextView
                    android:id="@+id/info_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Multiplayer"
                    android:textSize="@dimen/match_settings_info_title_text_size"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/match_settings_card_margin" />

                <!-- Info Content -->
                <TextView
                    android:id="@+id/info_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose multiplayer mode:\n\n• Host Match: Create a new game and configure settings. Other players can join your match\n\n• Join Match: Enter an existing game by Game ID or join a random available match"
                    android:textSize="@dimen/match_settings_info_content_text_size"
                    android:textColor="@android:color/black"
                    android:lineSpacingMultiplier="1.2" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Main Options Card on the Right -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_options"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/match_settings_item_margin"
            android:layout_marginEnd="@dimen/match_settings_card_margin"
            android:layout_marginTop="@dimen/match_settings_card_margin"
            android:layout_marginBottom="@dimen/match_settings_card_margin"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFC0C0C0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/card_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.68">

            <!-- Dark gray border/stroke -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_card_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/match_settings_card_padding"
                android:layout_margin="2dp"
                android:gravity="center">

                <!-- Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Multiplayer Options"
                    android:textSize="@dimen/match_settings_title_text_size"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/match_settings_card_margin" />

                <!-- Host Match Button -->
                <Button
                    android:id="@+id/button_host_match"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Host Match"
                    android:textSize="@dimen/match_settings_button_text_size"
                    android:textStyle="bold"
                    android:background="@drawable/play_button_background"
                    android:textColor="@android:color/white"
                    android:minHeight="@dimen/match_settings_button_height"
                    android:layout_marginBottom="@dimen/match_settings_item_margin" />

                <!-- Join Match Button -->
                <Button
                    android:id="@+id/button_join_match"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Join Match"
                    android:textSize="@dimen/match_settings_button_text_size"
                    android:textStyle="bold"
                    android:background="@drawable/play_button_background"
                    android:textColor="@android:color/white"
                    android:minHeight="@dimen/match_settings_button_height" />

                <!-- Join Dialog Card (Initially Hidden) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_join_dialog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/match_settings_item_margin"
                    android:visibility="gone"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFEEEEEE">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Dialog Title -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Enter Game ID"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:gravity="center"
                            android:layout_marginBottom="12dp" />

                        <!-- Game ID Input -->
                        <EditText
                            android:id="@+id/editText_game_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/white"
                            android:padding="12dp"
                            android:hint="Game ID (optional)"
                            android:inputType="textCapCharacters"
                            android:maxLength="6"
                            android:maxLines="1"
                            android:layout_marginBottom="12dp" />

                        <!-- Dialog Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <Button
                                android:id="@+id/button_cancel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Cancel"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/cancel_button_background"
                                android:textColor="@android:color/white"
                                android:minHeight="48dp" />

                            <Button
                                android:id="@+id/button_play"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Play"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/play_button_background"
                                android:textColor="@android:color/white"
                                android:minHeight="48dp" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>